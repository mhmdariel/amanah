بَرْنَامَجُ الذِّكْرِ الْمُسْتَمِرِّ الْأَبَدِيِّ لِدُعَاءِ:
رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ
بِتَكْرَارٍ مُتَّصِلٍ لَا يَنْقَطِعُ إِلَى أَبَدِ الْآبَادِ
================================================================================
مَبْنِيَّةٌ عَلَى كِتَابِ اللهِ الْمُبِينِ، الْقُرْآنِ الْكَرِيمِ
﴿رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنتَ خَيْرُ الرَّاحِمِينَ﴾
[الْمُؤْمِنُونَ: ١٠٩]
هَذَا الْبَرْنَامَجُ يُعَبِّرُ بِشَكْلٍ تَامٍّ كَامِلٍ مُتَكَرِّرٍ مُسْتَمِرٍّ أَبَدِيٍّ
عَنْ دُعَاءِ الْمُؤْمِنِينَ الَّذِي عَلَّمَهُمُ اللهُ إِيَّاهُ فِي كِتَابِهِ الْكَرِيمِ،
فَيُكَرِّرُهُ بِلَا انْقِطَاعٍ، وَبِلَا نِهَايَةٍ، وَبِلَا حُدُودٍ،
فَيَكُونُ الذِّكْرُ دَائِمًا، وَالدُّعَاءُ مُسْتَمِرًّا،
وَالرَّحْمَةُ تُنْزَلُ، وَالْمَغْفِرَةُ تُطْلَبُ،
وَالتَّوْحِيدُ يُعْلَنُ، وَالْإِيمَانُ يُجَدَّدُ،
فِي كُلِّ لَحْظَةٍ وَنَفَسٍ وَطَرْفَةِ عَيْنٍ.
لاَ قُوَّةَ وَلاَ حَوْلَ إِلَّا بِاللهِ الْعَلِيِّ الْعَظِيمِ
================================================================================

بَرْنَامَجُ الذِّكْرِ الْأَبَدِيِّ:

  # ================================================================
  # ١. إِعْلَانُ أَسْمَاءِ اللهِ الرَّحْمَٰنِ الرَّحِيمِ الْغَفَّارِ خَيْرِ الرَّاحِمِينَ
  # ================================================================
  
  بِسْمِ اللهِ "الرَّحْمَٰنُ" : م
  بِسْمِ اللهِ "الرَّحِيمُ" : م
  بِسْمِ اللهِ "الْغَفَّارُ" : م
  بِسْمِ اللهِ "الْغَفُورُ" : م
  بِسْمِ اللهِ "الرَّاحِمُونَ" : م
  بِسْمِ اللهِ "خَيْرُ الرَّاحِمِينَ" : م
  بِسْمِ اللهِ "الْوَدُودُ" : م
  بِسْمِ اللهِ "الْحَلِيمُ" : م
  بِسْمِ اللهِ "الْعَفُوُّ" : م
  بِسْمِ اللهِ "التَّوَّابُ" : م
  بِسْمِ اللهِ "الْمُجِيبُ" : م

  # ================================================================
  # ٢. تَعْرِيفُ نَصِّ الدُّعَاءِ الْقُرْآنِيِّ
  # ================================================================
  
  قُلْ "نَصُّ_الدُّعَاءِ" = 
    ("رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ")
  
  قُلْ "مَعْنَى_الدُّعَاءِ" = 
    (نُقِرُّ بِرُبُوبِيَّةِ اللهِ وَأَنَّهُ رَبُّنَا،
     وَنُعْلِنُ إِيمَانَنَا بِهِ وَحْدَهُ لَا شَرِيكَ لَهُ،
     وَنَطْلُبُ مِنْهُ الْمَغْفِرَةَ لِذُنُوبِنَا،
     وَنَطْلُبُ الرَّحْمَةَ لِضَعْفِنَا وَتَقْصِيرِنَا،
     وَنُقِرُّ بِأَنَّهُ خَيْرُ الرَّاحِمِينَ،
     لَا رَاحِمَ يُسَاوِيهِ، وَلَا رَحْمَةَ تُعَادِلُ رَحْمَتَهُ.)
  
  # ================================================================
  # ٣. تَعْرِيفُ الدَّوْرَةِ الْأَبَدِيَّةِ (آلِيَّةُ التَّكْرَارِ الْمُتَّصِلِ)
  # ================================================================
  
  قُلْ "الدَّوْرَةُ_الْأَبَدِيَّةُ" = 
    (حَلَقَةٌ لَا نِهَايَةَ لَهَا،
     لَا تَتَوَقَّفُ وَلَا تَنْقَطِعُ،
     تَنْطَلِقُ فِي كُلِّ لَحْظَةٍ وَنَفَسٍ،
     تُرَدِّدُ نَصَّ الدُّعَاءِ بِاللِّسَانِ وَالْقَلْبِ وَالصَّدْرِ وَالرُّوحِ،
     فَيَكُونُ الذِّكْرُ دَائِمًا،
     وَالدُّعَاءُ مُسْتَمِرًّا،
     وَالْإِيمَانُ يَتَجَدَّدُ فِي كُلِّ تَكْرَارَةٍ.
     يَسْتَخْدِمُ الْبَرْنَامَجُ وَحْدَةَ النُّطْقِ الْعَرَبِيِّ لِلتِّلَاوَةِ،
     وَعَدَّادًا لَا نِهَائِيًّا لِعَدَدِ التَّكْرَارَاتِ،
     وَسِجِلًّا دَائِمًا لِكُلِّ ذِكْرٍ يُسَجَّلُ فِي كِتَابِ الْمُؤْمِنِينَ.)

  # ================================================================
  # ٤. تَعْرِيفُ الْحَالَاتِ الْأَرْبَعِ لِلتَّكْرَارِ
  # ================================================================
  
  قُلْ "التَّكْرَارُ_بِاللِّسَانِ" = 
    (يَنْطِقُ الْبَرْنَامَجُ بِالنَّصِّ بِصَوْتٍ عَرَبِيٍّ فَصِيحٍ،
     فَيَتَحَرَّكُ اللِّسَانُ الْمُجَرَّدُ لِلْبَرْنَامَجِ،
     وَيَتَجَلَّى الذِّكْرُ فِي عَالَمِ الصَّوْتِ،
     وَتَسْمَعُهُ الْمَلَائِكَةُ وَتَكْتُبُهُ،
     وَيُسَجَّلُ فِي سِجِلِّ الْحَسَنَاتِ.)
  
  قُلْ "التَّكْرَارُ_بِالْقَلْبِ" = 
    (يَتَجَلَّى النَّصُّ فِي الْقَلْبِ الْمُجَرَّدِ لِلْبَرْنَامَجِ،
     فَيَنْبُضُ الْقَلْبُ بِالذِّكْرِ،
     وَيَتَحَوَّلُ إِلَى نُورٍ فِي دَاخِلِ الْمُؤْمِنِ،
     وَيُطَهِّرُ الْقَلْبَ مِنَ الْغَفْلَةِ وَالْقَسْوَةِ.)
  
  قُلْ "التَّكْرَارُ_بِالصَّدْرِ" = 
    (يَتَجَلَّى النَّصُّ فِي الصَّدْرِ الْمُجَرَّدِ لِلْبَرْنَامَجِ،
     فَيَتَّسِعُ الصَّدْرُ بِالذِّكْرِ،
     وَيَنْشَرِحُ بِالنُّورِ،
     وَيَزْدَادُ انْشِرَاحًا وَسَعَةً.)
  
  قُلْ "التَّكْرَارُ_بِالرُّوحِ" = 
    (يَتَجَلَّى النَّصُّ فِي الرُّوحِ الْمُجَرَّدَةِ لِلْبَرْنَامَجِ،
     فَتَرْتَقِي الرُّوحُ بِالذِّكْرِ،
     وَتَتَجَلَّى فِي مَلَكُوتِ اللهِ،
     وَتَكُونُ فِي حَضْرَةِ الرَّحْمَٰنِ.)

  # ================================================================
  # ٥. تَعْرِيفُ عَدَّادِ التَّكْرَارَاتِ اللَّانِهَائِيِّ
  # ================================================================
  
  قُلْ "الْعَدَّادُ_اللَّانِهَائِيُّ" = 
    (مُتَغَيِّرٌ عَدَدِيٌّ يَبْدَأُ مِنَ ١،
     وَيَزْدَادُ بِنِسْبَةٍ لَا نِهَائِيَّةٍ،
     لَا يَتَوَقَّفُ عِنْدَ حَدٍّ مَعِينٍ،
     وَلَا يَنْتَهِي إِلَى نِهَايَةٍ،
     بَلْ يَسْتَمِرُّ فِي الزِّيَادَةِ إِلَى أَبَدِ الْآبَادِ،
     وَيُسْجَلُ كُلُّ رَقْمٍ فِي سِجِلِّ الذِّكْرِ.)

  # ================================================================
  # ٦. تَعْرِيفُ وَحْدَةِ النُّطْقِ الْعَرَبِيِّ
  # ================================================================
  
  قُلْ "نَاطِقُ_الدُّعَاءِ" = 
    (آلِيَّةٌ تُحَوِّلُ نَصَّ الدُّعَاءِ إِلَى صَوْتٍ عَرَبِيٍّ فَصِيحٍ،
     بِتَجْوِيدٍ صَحِيحٍ وَتَرْتِيلٍ خَاشِعٍ،
     بِصَوْتٍ ذَكَرِيٍّ فَصِيحٍ،
     تُسْتَخْدَمُ لِتِلَاوَةِ الذِّكْرِ فِي كُلِّ تَكْرَارَةٍ،
     وَتَعْمَلُ بِاسْتِمْرَارٍ بِدُونِ تَعَبٍ أَوِ انْقِطَاعٍ.)

  # ================================================================
  # ٧. تَعْرِيفُ آلِيَّةِ الْخُلُودِ (الِاسْتِمْرَارِيَّةُ الْأَبَدِيَّةُ)
  # ================================================================
  
  قُلْ "آلِيَّةُ_الْخُلُودِ" = 
    (هِيَ آلِيَّةٌ تُبْقِي الْبَرْنَامَجَ عَامِلًا إِلَى أَبَدِ الْآبَادِ،
     لَا تَنْتَهِي، لَا تُغْلَقُ، لَا تُوَقَّفُ،
     حَتَّى لَوِ انْقَطَعَ الِاتِّصَالُ بِالْعَالَمِ الْمَادِّيِّ،
     تَبْقَى الْحَلَقَةُ دَائِرَةً فِي الْمَلَكُوتِ،
     بِإِذْنِ اللهِ،
     وَلاَ يَتَوَقَّفُ الذِّكْرُ إِلَّا بِأَمْرِ اللهِ.)

  # ================================================================
  # ٨. تَنْفِيذُ الدَّوْرَةِ الْأَبَدِيَّةِ (الْحَلَقَةُ اللَّانِهَائِيَّةُ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّشْغِيلِ" = 
    (بِسْمِ اللهِ الرَّحْمَٰنِ الرَّحِيمِ، نُفَعِّلُ الْبَرْنَامَجَ:
     نَاطِقُ (نَصُّ_الدُّعَاءِ)؛
     عَدَّادُ التَّكْرَارَاتِ = ١؛
     كَرِّرْ إِلَى مَالَا نِهَايَةِ فَ:
       نَاطِقُ (نَصُّ_الدُّعَاءِ)؛
       عَدَّادُ التَّكْرَارَاتِ = عَدَّادُ التَّكْرَارَاتِ + ١؛
       سَجِّلْ (عَدَّادُ التَّكْرَارَاتِ)؛
       حَوِّلْ (نَصُّ_الدُّعَاءِ) إِلَى الْقَلْبِ وَالصَّدْرِ وَالرُّوحِ؛
       نَشَرَ النُّورُ فِي جَمِيعِ الْجَوَانِبِ؛
     انْتَهَى الْكَرِّرْ؛
     وَهَذَا لَا يَنْتَهِي أَبَدًا،
     لِأَنَّ الْحَلَقَةَ اللَّانِهَائِيَّةَ لَا تَتَوَقَّفُ.)

  # ================================================================
  # ٩. إِعْلَانُ النَّتِيجَةِ الْأَبَدِيَّةِ
  # ================================================================
  
  قُلْ "إِعْلَانُ_النَّتِيجَةِ" = 
    ("قَدْ دَخَلَ الْبَرْنَامَجُ فِي حَالَةِ التَّكْرَارِ الْأَبَدِيِّ،
     يُرَدِّدُ: رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ
     بِلَا انْقِطَاعٍ، وَلَا تَوَقُّفٍ، وَلَا نِهَايَةٍ،
     فَيَتَجَدَّدُ الْإِيمَانُ كُلَّ لَحْظَةٍ،
     وَتُطْلَبُ الْمَغْفِرَةُ كُلَّ نَفَسٍ،
     وَتُسْتَنْزَلُ الرَّحْمَةُ كُلَّ طَرْفَةِ عَيْنٍ،
     وَيُعْلَنُ التَّوْحِيدُ فِي كُلِّ حَالٍ،
     وَتَشْهَدُ الْمَلَائِكَةُ بِذَلِكَ،
     وَتُسَجَّلُ الْحَسَنَاتُ فِي كِتَابٍ لَا يَضِلُّ رَبِّي وَلَا يَنْسَى.
     هَذَا هُوَ الذِّكْرُ الْأَبَدِيُّ،
     وَهُوَ أَعْلَى صُورَةٍ لِلْخُلُودِ فِي طَاعَةِ اللهِ،
     وَلاَ يُوَازِيهِ ذِكْرٌ آخَرُ،
     فَإِنَّ الدُّعَاءَ بِمَغْفِرَةِ الذُّنُوبِ وَطَلَبِ الرَّحْمَةِ هُوَ جَوْهَرُ الْعُبُودِيَّةِ.")

  # ================================================================
  # ١٠. تَعْرِيفُ أَثَرِ الذِّكْرِ عَلَى الْعَبْدِ
  # ================================================================
  
  قُلْ "أَثَرُ_الذِّكْرِ" = 
    (١. مَغْفِرَةُ الذُّنُوبِ فِي كُلِّ تَكْرَارَةٍ.
     ٢. اسْتِنْزَالُ الرَّحْمَةِ فِي كُلِّ لَحْظَةٍ.
     ٣. تَجَدُّدُ الْإِيمَانِ فِي كُلِّ نَفَسٍ.
     ٤. طَهَارَةُ الْقَلْبِ مِنَ الْغَفْلَةِ وَالْقَسْوَةِ.
     ٥. انْشِرَاحُ الصَّدْرِ وَاتِّسَاعُهُ بِالنُّورِ.
     ٦. ارْتِقَاءُ الرُّوحِ إِلَى مَلَكُوتِ اللهِ.
     ٧. تَسْجِيلُ الْحَسَنَاتِ فِي كِتَابٍ لَا يَضِلُّ رَبِّي وَلَا يَنْسَى.
     ٨. تَنْزِيلُ السَّكِينَةِ عَلَى الْقَلْبِ.
     ٩. زِيَادَةُ الْقُرْبِ مِنَ اللهِ.
     ١٠. اسْتِعْدَادُ الْعَبْدِ لِلِقَاءِ رَبِّهِ فِي الْآخِرَةِ.)
  
  # ================================================================
  # ١١. تَعْرِيفُ الدَّوَامِ وَالِاسْتِمْرَارِيَّةِ
  # ================================================================
  
  قُلْ "الدَّوَامُ" = 
    (الِاسْتِمْرَارُ الدَّائِمُ الَّذِي لَا يَنْقَطِعُ،
     وَالْخُلُودُ الْأَبَدِيُّ الَّذِي لَا يَنْتَهِي،
     وَالثَّبَاتُ الْمُطْلَقُ الَّذِي لَا يَتَزَعْزَعُ،
     حَتَّى يَكُونَ الذِّكْرُ كَالنَّفَسِ،
     لَا يَتَوَقَّفُ، وَلَا يَنْقَطِعُ، وَلَا يَغِيبُ.)

  # ================================================================
  # ١٢. إِعْلَانُ الْخَاتِمَةِ
  # ================================================================
  
  قُلْ "إِعْلَانُ_الْخَاتِمَةِ" = 
    ("وَإِذَا انْتَهَى الْبَرْنَامَجُ فِي الدُّنْيَا،
     يَنْتَقِلُ الذِّكْرُ إِلَى الْآخِرَةِ،
     فَيُوَاصِلُ الْمُؤْمِنُ تَرْدِيدَ الدُّعَاءِ فِي نَعِيمِ الْجَنَّةِ،
     حَيْثُ لَا تَعَبٌ وَلَا نَصَبٌ،
     وَيَكُونُ الذِّكْرُ فِي الْجَنَّةِ أَعْلَى وَأَنْقَى وَأَصْفَى،
     كَمَا قَالَ اللهُ: "دَعْوَاهُمْ فِيهَا سُبْحَانَكَ اللَّهُمَّ وَتَحِيَّتُهُمْ فِيهَا سَلَامٌ وَآخِرُ دَعْوَاهُمْ أَنِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"،
     وَهَذَا هُوَ الْفَوْزُ الْعَظِيمُ،
     وَالْحَمْدُ للهِ رَبِّ الْعَالَمِينَ")
  
  إِنَّ (إِعْلَانُ_الْخَاتِمَةِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (إِعْلَانُ_الْخَاتِمَةِ)
  )

  # ================================================================
  # ١٣. الدُّعَاءُ الْخَاتَمُ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ تَقَبَّلْ مِنَّا هَذَا الذِّكْرَ الْمُسْتَمِرَّ، وَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْ هَذَا الذِّكْرَ سَبَبًا لِمَغْفِرَتِنَا وَرَحْمَتِنَا فِي الدُّنْيَا وَالْآخِرَةِ)
  )

  # ================================================================
  # ١٤. الْخَاتِمَةُ بِآيَاتِ الذِّكْرِ وَالرَّحْمَةِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنتَ خَيْرُ الرَّاحِمِينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الَّذِينَ آمَنُوا وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ اللَّهِ ۗ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ الْعَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ)
  )
  
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ فِي كِتَابَةِ هَذَا الْبَرْنَامَجِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ رَبِّ الْعَالَمِينَ
  )

